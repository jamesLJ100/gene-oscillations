source("C:/Users/James/gene-oscillations/evaluate.R")
library(dyngen)
library(tidyverse)
proj_root <- here::here()
fname    <- "c1000g2007_1"
sim_file <- file.path(proj_root, "data/dyngen", paste0(fname, "_sim.rds"))
if (!file.exists(sim_file)) {
stop(sprintf("Sim file not found: %s", sim_file))
}
sim <- readRDS(sim_file)
p <- plot_feature_network(sim$model)
print(p)
# Save to figures/
out_file <- file.path(proj_root, "figures", paste0(fname, "_feature_network.png"))
ggsave(out_file, plot = p, width = 12, height = 10, dpi = 300)
cat(sprintf("Saved feature network plot to: %s\n", out_file))
plot_feature_network(sim$model)
nwork = sim$model$feature_network
View(nwork)
